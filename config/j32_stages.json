{
  "name": "Link16 J3.2 Air Track Processing Workflow",
  "version": "1.0.0",
  "description": "Workflow for processing Link-16 J3.2 Air Track messages with 5 standardized processing stages (T1-T5)",
  "stages": [
    {
      "id": "prepare_send",
      "name": "Prepare J3.2 Message Send",
      "description": "Initialize, classify, encode, and validate J3.2 air track message before transmission (T1)",
      "trigger": "manual",
      "steps": [
        {"id": "s1", "node": "init_j32_data"},
        {"id": "s2", "node": "classify_j32"},
        {"id": "s3", "node": "encode_j32_message"},
        {"id": "s4", "node": "validate_j32_message", "on_reject": "skip"}
      ]
    },
    {
      "id": "send",
      "name": "Transmit J3.2 Message",
      "description": "Check send conditions, assign NPG slot, and transmit message (T2)",
      "trigger": "auto",
      "steps": [
        {"id": "s1", "node": "check_send_condition",
         "branches": [
           {"condition": "can_send == true", "goto": "s2"},
           {"condition": "can_send == false", "goto": "end"}
         ],
         "default_goto": "end"},
        {"id": "s2", "node": "assign_npg_slot"},
        {"id": "s3", "node": "transmit", "on_reject": "abort"}
      ]
    },
    {
      "id": "receive",
      "name": "Receive and Process J3.2 Message",
      "description": "Decode, filter, correlate, and store received J3.2 air tracks with conditional routing (T3)",
      "trigger": "auto",
      "steps": [
        {"id": "r1", "node": "decode_j32_message", "on_reject": "abort"},
        {"id": "r2", "node": "j32_receive_filter", "on_reject": "skip"},
        {"id": "r3", "node": "j32_correlate", "on_reject": "abort",
         "branches": [
           {"condition": "correlation == new", "goto": "r4"},
           {"condition": "correlation == update", "goto": "r5"},
           {"condition": "correlation == duplicate", "goto": "r6"}
         ]},
        {"id": "r4", "node": "create_j32_entry", "on_reject": "abort", "default_goto": "r7"},
        {"id": "r5", "node": "update_j32_entry", "on_reject": "abort", "default_goto": "r7"},
        {"id": "r6", "node": "duplicate_j32_resolve"},
        {"id": "r7", "node": "store_j32", "on_reject": "skip"}
      ]
    },
    {
      "id": "clear",
      "name": "Clear Expired J3.2 Tracks",
      "description": "Check TTL and remove expired air tracks from database (T4)",
      "trigger": "timer",
      "steps": [
        {"id": "c1", "node": "check_ttl_j32",
         "branches": [
           {"condition": "expired == true", "goto": "c2"},
           {"condition": "expired == false", "goto": "c3"}
         ]},
        {"id": "c2", "node": "check_source_ju", "default_goto": "c4"},
        {"id": "c3", "node": "retain_j32_entry", "default_goto": "end"},
        {"id": "c4", "node": "delete_j32_entry", "default_goto": "end"}
      ]
    },
    {
      "id": "special_process",
      "name": "Handle J3.2 Anomalies and Special Cases",
      "description": "Detect and resolve anomalies in J3.2 processing (T5)",
      "trigger": "exception",
      "steps": [
        {"id": "t1", "node": "j32_detect_anomaly"},
        {"id": "t2", "node": "resolve_conflict"},
        {"id": "t3", "node": "j32_clamp_field"},
        {"id": "t4", "node": "log_result"}
      ]
    }
  ]
}
